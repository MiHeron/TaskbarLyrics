<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarLyrics.Watchdog</AssemblyName>
    <RootNamespace>TaskbarLyrics.Watchdog</RootNamespace>
    <ApplicationIcon>..\TaskbarLyrics.App\Assets\AppIcon\TaskbarLyrics.ico</ApplicationIcon>
    <Version>1.7.5</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed Condition="'$(PublishAot)' != 'true'">true</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

</Project>
